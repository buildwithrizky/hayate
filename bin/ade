#!/usr/bin/env bun
import { spawn } from "node:child_process";
import { resolve } from "node:path";
import { existsSync, mkdirSync, readFileSync, writeFileSync, unlinkSync, openSync } from "node:fs";
import { homedir } from "node:os";

const adeConfigDir = resolve(homedir(), ".ade");
if (!existsSync(adeConfigDir)) {
  mkdirSync(adeConfigDir, { recursive: true });
}

const pidFile = resolve(adeConfigDir, "ade.pid");
const logFile = resolve(adeConfigDir, "ade.log");
const serverScript = resolve(import.meta.dir, "../src/server.ts");

const args = process.argv.slice(2);

// Help
if (args.includes("--help") || args.includes("-h") || args[0] === "help") {
  console.log(`
\x1b[1m\x1b[36m⚡ ADE (Autonomous Developer Environment) Harness\x1b[0m

\x1b[1mUsage:\x1b[0m
  ade start [-d|-f] [-p <port>] [--no-open]   Start ADE server (default: background)
  ade stop                                    Stop ADE server
  ade restart [-d|-f]                         Restart ADE server
  ade status                                  Check ADE status
  ade logs                                    Stream server logs

\x1b[1mOptions:\x1b[0m
  -d, --detach             Run in background (default for start)
  -f, --foreground         Run in foreground
  -p, --port <number>      Custom port (default: 3456)
  --no-open                Do not automatically open browser
  -v, --version            Show version
  -h, --help               Show help
`);
  process.exit(0);
}

if (args.includes("--version") || args.includes("-v") || args[0] === "version") {
  console.log("ade v0.1.0");
  process.exit(0);
}

let action = "";
const filteredArgs: string[] = [];

for (const arg of args) {
  if (!action && ["start", "stop", "restart", "status", "logs"].includes(arg)) {
    action = arg;
    continue;
  }
  filteredArgs.push(arg);
}

if (!action) {
  action = args.length === 0 ? "status" : "status";
}

function isPidRunning(pid: number): boolean {
  try {
    process.kill(pid, 0);
    return true;
  } catch {
    return false;
  }
}

function getRunningPid(): number | null {
  if (!existsSync(pidFile)) return null;
  try {
    const raw = readFileSync(pidFile, "utf-8").trim();
    const pid = Number(raw);
    if (pid && isPidRunning(pid)) return pid;
  } catch {}
  try { unlinkSync(pidFile); } catch {}
  return null;
}

async function isPortInUse(port: number): Promise<boolean> {
  return new Promise((resolvePromise) => {
    const server = Bun.listen({
      port,
      hostname: "0.0.0.0",
      socket: {
        data() {},
        open(ws) { ws.close(); }
      }
    });
    server.stop(true);
    resolvePromise(false);
  }).catch(() => true);
}

function stopProcess(): boolean {
  const pid = getRunningPid();
  if (!pid) {
    if (existsSync(pidFile)) {
      try { unlinkSync(pidFile); } catch {}
    }
    return false;
  }

  try { process.kill(pid, "SIGTERM"); } catch {}

  const start = Date.now();
  while (Date.now() - start < 1500) {
    if (!isPidRunning(pid)) break;
    Bun.sleepSync(50);
  }

  if (isPidRunning(pid)) {
    try { process.kill(pid, "SIGKILL"); } catch {}
    Bun.sleepSync(50);
  }

  try { unlinkSync(pidFile); } catch {}
  console.log(`\x1b[32m✔ Stopped ADE\x1b[0m (PID: ${pid})`);
  return true;
}

// 1. Status command
if (action === "status") {
  const pid = getRunningPid();
  if (pid) {
    console.log(`\x1b[32m● ADE:\x1b[0m Running (PID: ${pid}) ➜ \x1b[36mhttp://localhost:3456\x1b[0m`);
  } else {
    console.log(`\x1b[90m○ ADE:\x1b[0m Not running`);
  }
  process.exit(0);
}

// 2. Stop command
if (action === "stop") {
  if (!stopProcess()) {
    console.log("\x1b[33mADE is not running.\x1b[0m");
  }
  process.exit(0);
}

// 3. Restart command
if (action === "restart") {
  stopProcess();
  action = "start";
}

// 4. Logs command
if (action === "logs") {
  if (!existsSync(logFile)) {
    console.log(`\x1b[90mNo log file found at ${logFile}\x1b[0m`);
    process.exit(0);
  }
  console.log(`\x1b[90mStreaming logs from ${logFile} (Ctrl+C to exit)...\x1b[0m\n`);
  const tail = spawn("tail", ["-f", logFile], { stdio: "inherit" });
  process.on("SIGINT", () => {
    tail.kill();
    process.exit(0);
  });
} else if (action === "start") {
  let port = 3456;
  const portIdx = filteredArgs.findIndex(a => a === "--port" || a === "-p");
  if (portIdx !== -1 && filteredArgs[portIdx + 1]) {
    port = Number(filteredArgs[portIdx + 1]) || 3456;
  }

  const noOpen = filteredArgs.includes("--no-open");
  const isForeground = filteredArgs.includes("-f") || filteredArgs.includes("--foreground");
  const isInternalDaemon = filteredArgs.includes("--internal-daemon");

  const existingPid = getRunningPid();
  if (existingPid && !isInternalDaemon) {
    console.log(`\x1b[33mADE is already running (PID: ${existingPid})\x1b[0m`);
    console.log(`  \x1b[36m➜ http://localhost:${port}\x1b[0m`);
    if (!noOpen) spawn("open", [`http://localhost:${port}`], { detached: true, stdio: "ignore" }).unref();
    process.exit(0);
  }

  if (await isPortInUse(port)) {
    console.error(`\x1b[31m✖ Port ${port} is already in use by another process.\x1b[0m`);
    process.exit(1);
  }

  // Background detach by default unless foreground requested
  if (!isForeground && !isInternalDaemon) {
    const logFd = openSync(logFile, "a");
    const child = spawn("bun", [
      resolve(import.meta.dir, "ade"),
      "start",
      "--internal-daemon",
      "--port", String(port)
    ], {
      detached: true,
      stdio: ["ignore", logFd, logFd],
      env: {
        ...process.env,
        PORT: String(port),
        ADE_CONFIG_DIR: adeConfigDir
      }
    });

    writeFileSync(pidFile, String(child.pid));
    child.unref();

    console.log(`
\x1b[1m\x1b[32m✔ ADE started in background!\x1b[0m
  \x1b[36m➜ Local:\x1b[0m   \x1b[4m\x1b[36mhttp://localhost:${port}\x1b[0m
  \x1b[90m➜ Logs:\x1b[0m    ade logs
  \x1b[90m➜ Status:\x1b[0m  ade status
  \x1b[90m➜ Stop:\x1b[0m    ade stop
`);

    if (!noOpen) {
      setTimeout(() => {
        try { spawn("open", [`http://localhost:${port}`], { detached: true, stdio: "ignore" }).unref(); } catch {}
      }, 400);
    }
    process.exit(0);
  }

  // Internal daemon or foreground runner
  writeFileSync(pidFile, String(process.pid));

  function cleanupPid() {
    try {
      if (existsSync(pidFile)) {
        const saved = readFileSync(pidFile, "utf-8").trim();
        if (Number(saved) === process.pid) unlinkSync(pidFile);
      }
    } catch {}
  }

  process.on("exit", cleanupPid);
  process.on("SIGINT", () => {
    cleanupPid();
    process.exit(0);
  });
  process.on("SIGTERM", () => {
    cleanupPid();
    process.exit(0);
  });

  process.env.PORT = String(port);
  process.env.ADE_CONFIG_DIR = adeConfigDir;

  if (!isInternalDaemon) {
    console.log(`
\x1b[1m\x1b[36m⚡ ADE Harness\x1b[0m \x1b[90m(Web ADE Terminal)\x1b[0m
  \x1b[32m➜\x1b[0m Local:   \x1b[4m\x1b[36mhttp://localhost:${port}\x1b[0m
  \x1b[90m➜ Config:  ${adeConfigDir}/workspaces.json\x1b[0m
  \x1b[90m➜ Press Ctrl+C to stop\x1b[0m
`);
  }

  await import(serverScript);

  if (!noOpen && !isInternalDaemon) {
    setTimeout(() => {
      try { spawn("open", [`http://localhost:${port}`], { detached: true, stdio: "ignore" }).unref(); } catch {}
    }, 400);
  }
}
