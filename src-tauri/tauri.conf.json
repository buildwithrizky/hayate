{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hayate",
  "version": "0.1.1",
  "identifier": "com.hayate.app",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/buildwithrizky/hayate/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyMDdDNjIzNUM1RTExOEMKUldTTUVWNWNJOFlIOHQ2WEhRN2dlUnZpMzJlSFJwb2RULzRzVUE3VlUySlFxU2w3WjdzQTQ2SEoK"
    }
  },
  "build": {
    "frontendDist": "../public",
    "beforeDevCommand": null,
    "beforeBuildCommand": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Hayate",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "../public/*",
      "../public/**/*"
    ],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
